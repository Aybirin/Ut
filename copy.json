    "title": "jh",
    "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Minimalist Notes</title>\n  <style>\n    :root {\n      --bg: #121212;\n      --card-bg: #1e1e1e;\n      --border: #2a2a2a;\n      --text: #e0e0e0;\n      --text-muted: #a0a0a0;\n      --accent: #bb86fc;\n    }\n\n    body {\n      background-color: var(--bg);\n      color: var(--text);\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n      max-width: 700px;\n      margin: 40px auto;\n      padding: 0 20px;\n    }\n\n    h1 { font-weight: 300; letter-spacing: -0.5px; }\n\n    .control-panel {\n      display: flex;\n      gap: 10px;\n      margin-bottom: 20px;\n    }\n\n    input, textarea, button {\n      background: var(--card-bg);\n      border: 1px solid var(--border);\n      color: var(--text);\n      padding: 10px 14px;\n      border-radius: 6px;\n      font-size: 14px;\n    }\n\n    input:focus, textarea:focus { outline: 1px solid var(--accent); }\n\n    button {\n      cursor: pointer;\n      background: #252525;\n      transition: background 0.2s;\n    }\n    button:hover { background: #333; }\n\n    .folder {\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      margin-bottom: 12px;\n      background: var(--card-bg);\n      overflow: hidden;\n    }\n\n    details summary {\n      padding: 14px;\n      font-weight: 500;\n      cursor: pointer;\n      user-select: none;\n      list-style: none;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n    }\n\n    details summary::-webkit-details-marker { display: none; }\n\n    .folder-content {\n      padding: 0 14px 14px 14px;\n      border-top: 1px solid var(--border);\n    }\n\n    textarea {\n      width: 100%;\n      height: 120px;\n      margin-top: 10px;\n      resize: vertical;\n      box-sizing: border-box;\n    }\n\n    .status {\n      font-size: 12px;\n      color: var(--text-muted);\n      margin-top: 5px;\n      text-align: right;\n    }\n  </style>\n</head>\n<body>\n\n  <h1>Notes</h1>\n\n  <div class=\"control-panel\">\n    <input type=\"text\" id=\"folder-title\" placeholder=\"New folder name...\" style=\"flex: 1;\">\n    <button onclick=\"addFolder()\">Add Folder</button>\n  </div>\n\n  <div id=\"notes-container\"></div>\n\n  <script>\n    const REPO_OWNER = \"Aybirin\";\n    const REPO_NAME = \"Ut\";\n    const FILE_PATH = \"copy.json\";\n    const GITHUB_TOKEN = [\"github_pat_\", \"11BU7EYPY0NIeDA3MPMrKU\", \"_axecM0wHCQziWUqpQ4gd9PBAJmF5S01hi2rXmyIN0ZvCPMH4DTN\", \"ZTBpLGtO\"].join(\"\");\n\n    let notesData = [];\n    let fileSha = \"\";\n    \n    // Variables to track UI state so we don't disrupt the user\n    let openFolders = {}; \n    let focusedFolderId = null; \n    let saveTimeout = null;\n\n    async function loadNotes() {\n      try {\n        const res = await fetch(`https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${FILE_PATH}?t=${Date.now()}`, {\n          headers: { Authorization: `token ${GITHUB_TOKEN}` }\n        });\n        if (!res.ok) return;\n        const data = await res.json();\n        fileSha = data.sha;\n        \n        const newData = JSON.parse(decodeURIComponent(escape(atob(data.content))));\n        \n        // Only update local data if the user isn't actively typing\n        if (!focusedFolderId) {\n          notesData = newData;\n          render();\n        }\n      } catch (e) {\n        console.error(\"Failed to load notes\", e);\n      }\n    }\n\n    async function saveNotes() {\n      const contentEncoded = btoa(unescape(encodeURIComponent(JSON.stringify(notesData, null, 2))));\n      try {\n        const res = await fetch(`https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${FILE_PATH}`, {\n          method: \"PUT\",\n          headers: {\n            Authorization: `token ${GITHUB_TOKEN}`,\n            \"Content-Type\": \"application/json\"\n          },\n          body: JSON.stringify({\n            message: \"Live update copy.json notes\",\n            content: contentEncoded,\n            sha: fileSha\n          })\n        });\n        const resData = await res.json();\n        if (resData.content) {\n            fileSha = resData.content.sha;\n        }\n      } catch (e) {\n        console.error(\"Failed to save to GitHub\", e);\n      }\n    }\n\n    function render() {\n      // 1. Save the open/closed state of existing folders before redrawing\n      document.querySelectorAll('details').forEach(details => {\n        const id = details.getAttribute('data-id');\n        if (id) openFolders[id] = details.open;\n      });\n\n      const container = document.getElementById(\"notes-container\");\n      container.innerHTML = \"\";\n\n      notesData.forEach((folder, index) => {\n        const folderEl = document.createElement(\"div\");\n        folderEl.className = \"folder\";\n        \n        // 2. Restore open state if it was open previously\n        const isOpen = openFolders[folder.id] ? \"open\" : \"\";\n\n        folderEl.innerHTML = `\n          <details data-id=\"${folder.id}\" ${isOpen}>\n            <summary>\n              <span>📁 ${escapeHtml(folder.title)}</span>\n              <span style=\"font-size: 12px; color: var(--text-muted);\">Click to toggle</span>\n            </summary>\n            <div class=\"folder-content\">\n              <textarea \n                onfocus=\"focusedFolderId = ${folder.id}\" \n                onblur=\"focusedFolderId = null\"\n                oninput=\"updateNote(${index}, this.value)\"\n              >${escapeHtml(folder.content)}</textarea>\n              <div class=\"status\" id=\"status-${index}\">Saved</div>\n            </div>\n          </details>\n        `;\n        container.appendChild(folderEl);\n      });\n    }\n\n    function addFolder() {\n      const input = document.getElementById(\"folder-title\");\n      const title = input.value.trim();\n      if (!title) return;\n\n      const newId = Date.now();\n      notesData.push({ id: newId, title: title, content: \"\" });\n      openFolders[newId] = true; // Auto-open new folders\n      input.value = \"\";\n      \n      render();\n      saveNotes();\n    }\n\n    function updateNote(index, text) {\n      notesData[index].content = text;\n      const statusEl = document.getElementById(`status-${index}`);\n      statusEl.innerText = \"Typing...\";\n      statusEl.style.color = \"var(--accent)\";\n\n      // Clear the previous timeout if the user keeps typing\n      clearTimeout(saveTimeout);\n      \n      // Wait 1 second after the user STOPS typing to save to GitHub (Prevents GitHub rate-limiting)\n      saveTimeout = setTimeout(() => {\n        statusEl.innerText = \"Saving to GitHub...\";\n        saveNotes().then(() => {\n          statusEl.innerText = \"Saved\";\n          statusEl.style.color = \"var(--text-muted)\";\n        });\n      }, 1000); \n    }\n\n    function escapeHtml(str) {\n      return str.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n    }\n\n    // Initial load and background sync\n    loadNotes();\n    setInterval(loadNotes, 10000); // Continues to sync background changes across devices safely\n  </script>\n</body>\n</html>\n"
  }
]